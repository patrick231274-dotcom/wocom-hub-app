<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- GF Driver, Google Play build (package com.wocom.gfdriver). Location while On shift runs as a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <!-- Play forbids self-updating apps; Play delivers updates instead. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:node="remove"/>
    <!-- Delivery photos come from the camera; no media-library access. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove"/>
    <!-- Drivers never browse the phone's contacts (customers are called through the shop's system). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" tools:node="remove"/>
    <!-- Audio calls only: no camera foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" tools:node="remove"/>
    <application>
        <service android:name="com.hiennv.flutter_callkit_incoming.CallkitNotificationService"
            android:foregroundServiceType="phoneCall|microphone" tools:replace="android:foregroundServiceType"/>
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.wocomfiles" tools:node="remove"/>
    </application>
</manifest>
